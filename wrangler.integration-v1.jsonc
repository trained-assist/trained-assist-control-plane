{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trained-assist-cp-v1-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "services": [
    {
      "binding": "COMMUNICATION_SERVICE",
      "service": "trained-assist-communication-v1-sandbox"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ta-integration-v1-taskstore",
      "database_id": "8da66f9c-6736-4488-bcbd-dec1ae1b2036",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "ta-integration-v1-task-workflow",
      "binding": "TASK_WORKFLOW",
      "class_name": "TaskWorkflow"
    }
  ],
  "vars": {
    "ROUTER_SELECTOR": "communication_v1",
    "ROUTER_CONTINUATION_ENABLED": "true",
    "ROUTER_AGENT_ALLOWED": "true",
    "ROUTER_AGENT_ENGINE": "dynamic-ip-azure-agent-run",
    "RUN_SPEC_REPOSITORY": "{\"fullName\":\"trained-assist/ai-agent-runner\"}",
    "RUN_SPEC_ENV_ALLOWLIST": "LLM_LADDER_TOKEN",
    "RUN_SPEC_OUTPUTS": "[{\"path\":\"outputs/category-results.csv\",\"name\":\"Category totals\",\"mime\":\"text/csv\"}]",
    "RUN_SPEC_TIMEOUT_MS": "300000",
    "RUN_SPEC_MAX_OUTPUT_BYTES": "1048576",
    "RUN_SPEC_MAX_LOG_BYTES": "1048576",
    "RUN_SPEC_STARTUP_TIMEOUT_MS": "600000",
    "PILOT_ENABLED": "true",
    "PILOT_COHORT_PROFILE_IDS": "integration-v1",
    "DELIVERY_ADAPTER": "local"
  }
}
