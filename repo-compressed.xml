<file path=".github/workflows/telegram-ux-sandbox-test-pass.yml">
name: Deploy and verify Telegram UX sandbox test pass
on:
  workflow_dispatch:
    inputs:
      mode:
        description: Inspect state, verify sandbox3 Runner credentials, or bootstrap mock pair
        type: choice
        options: [inventory, preflight, candidate-preflight, sandbox3-public-preflight, pair-sandbox3-cp, sandbox3-cp-mock-probe, repair-permissions, bootstrap]
        default: inventory
        required: true
permissions:
  contents: read
  actions: read
  attestations: read
concurrency:
  group: telegram-ux-sandbox-runner-credentials
  cancel-in-progress: false
jobs:
  bootstrap:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: sandbox
    steps:
      - uses: actions/checkout@v4
        id: checkout
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
      - run: npm ci
      - name: Inspect sandbox or explicitly bootstrap the mock-test pair
        env:
          GH_TOKEN: ${{ github.token }}
          CF_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CP_TELEGRAM_UX_PRINCIPAL_SECRET: ${{ secrets.CP_TELEGRAM_UX_PRINCIPAL_SECRET }}
          RUNNER_API_KEY_AGENT_API: ${{ secrets.RUNNER_API_KEY_AGENT_API }}
          RUNNER_PROFILE_DELEGATION_SECRET: ${{ secrets.RUNNER_PROFILE_DELEGATION_SECRET }}
          RUNNER_MOCK_KEY_SEED: ${{ secrets.RUNNER_MOCK_KEY_SEED }}
          VM2_SSH_PRIVATE_KEY: ${{ secrets.VM2_SSH_PRIVATE_KEY }}
          SANDBOX3_NATIVE_WORKER_TOKEN: ${{ secrets.SANDBOX3_NATIVE_WORKER_TOKEN }}
          SANDBOX3_PROFILE_GITHUB_TOKEN: ${{ secrets.SANDBOX3_PROFILE_GITHUB_TOKEN }}
          SANDBOX3_GCS_CREDENTIALS: ${{ secrets.SANDBOX3_GCS_CREDENTIALS }}
          SANDBOX3_GCS_BUCKET: ${{ vars.SANDBOX3_GCS_BUCKET }}
          SANDBOX3_NATIVE_WORKER_SHA: ${{ vars.SANDBOX3_NATIVE_WORKER_SHA }}
          GITHUB_SHA: ${{ github.sha }}
          BOOTSTRAP_MODE: ${{ inputs.mode }}
        run: |
          case "$BOOTSTRAP_MODE" in
            inventory|preflight|candidate-preflight|sandbox3-public-preflight|pair-sandbox3-cp|sandbox3-cp-mock-probe|repair-permissions|bootstrap) ;;
            *) exit 1 ;;
          esac
          node --experimental-strip-types tools/bootstrap-telegram-ux-mock-runner.mjs "--$BOOTSTRAP_MODE"
      - name: Remove completed tagged sandbox3 test tasks
        if: always() && steps.checkout.outcome == 'success'
        env:
          CF_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: d740a05e9442c1d0feacae2dfc673e93
        run: node tools/sandbox3-test-cleanup.mjs --apply
      - name: Upload sanitized bootstrap evidence
        if: always() && hashFiles('sandbox-bootstrap-evidence.json', 'sandbox3-test-cleanup-evidence.json') != ''
        uses: actions/upload-artifact@v4
        with:
          name: telegram-ux-sandbox-test-pass-${{ github.run_id }}
          path: |
            sandbox-bootstrap-evidence.json
            sandbox3-test-cleanup-evidence.json
          if-no-files-found: error
          retention-days: 30
</file>

