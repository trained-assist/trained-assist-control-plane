{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trained-assist-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Cloudflare error 1042: by default a Worker may NOT fetch another Worker of the
  // SAME zone/account over a public hostname — the request is answered 404/1042
  // before it ever reaches the target's routes. Both the control plane and the
  // Telegram gateway live in this account, so the C02.1 seam (control plane → POST
  // /deliver) cannot work without this flag; it makes such fetches resolve like a
  // public client would, going out via the public internet.
  //
  // Chosen over a service binding on purpose: the seam addresses the gateway by
  // URL (GATEWAY_DELIVERY_URL), so staging and prod point at different gateways
  // with the same code. A service binding would bind by worker name and remove that
  // indirection.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Песочница на workers.dev: публичный URL нужен для прогона «Cloudflare → VM
  // Runner». Доступ закрыт проверяющей аутентификацией (HMAC по binding
  // PRINCIPAL_SECRET) — без подписи любой запрос получает 401.
  "workers_dev": true,
  // Планировщик сквозного watchdog (arch#132 П3c). Детектор без планировщика —
  // мёртвый код: runStuckInputSweep никто не звал. Раз в минуту достаточно для
  // минутного watchdog; отметка работоспособности пишется только после успеха.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": { "enabled": false },
  // Изолированная песочница own-API dogfood (#23): отдельная база D1, отдельный
  // воркер и отдельное имя workflow. Имя умышленно НЕ «task-workflow»: это имя
  // занято пилотом p-db-a1-cloud-smoke, и wrangler при деплое перепривязывает
  // workflow к последнему задеплоенному воркеру — то есть сломал бы чужой.
  // Продакшн-контроллера в этом аккаунте нет — деплой создаёт новый воркер,
  // живой сервис не переключается и не мигрирует.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ta-cp23-sandbox-taskstore",
      "database_id": "afea55d7-b186-4afb-a6d8-5ca71a58d947",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "ta-cp23-task-workflow",
      "binding": "TASK_WORKFLOW",
      "class_name": "TaskWorkflow"
    }
  ],
  "services": [
    {
      "binding": "INGRESS_BUFFER",
      "service": "trained-assist-ingress-buffer-sandbox"
    }
  ]
}
