{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trained-assist-cp-production",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ta-cp-production-taskstore",
    "database_id": "86d36407-c219-4cae-9a5e-6bfb042bd61c",
    "migrations_dir": "migrations"
  }],
  "workflows": [{
    "name": "ta-cp-production-task-workflow",
    "binding": "TASK_WORKFLOW",
    "class_name": "TaskWorkflow"
  }],
  "vars": {
    "DEPLOYMENT_ENV": "production",
    "PREVIEW_ONLY": "false",
    "PILOT_ENABLED": "true",
    "PILOT_ACTIVATED_AT": "2026-10-12T00:00:00.000Z",
    "ROUTER_AGENT_ALLOWED": "true"
  }
}
