{
  "name": "trained-assist-control-plane",
  "private": true,
  "type": "module",
  "description": "Trained Assist control plane: Task Store (D1) + Workflow Port (Cloudflare Workflows)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply task-store --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.146.0"
  }
}
