{
  "name": "trained-assist-control-plane",
  "private": true,
  "type": "module",
  "description": "Trained Assist control plane: Task Store (D1) + Workflow Port (Cloudflare Workflows)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run check:evidence",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply control-plane-task-store --local",
    "db:query:local": "wrangler d1 execute control-plane-task-store --local --command",
    "web:e2e": "node web/e2e/run-m1-web-slice-e2e.mjs",
    "web:dev": "wrangler dev -c web/wrangler.web.jsonc",
    "eval:fast-replies": "node --experimental-strip-types --import ./tools/ts-ext-resolver.mjs tools/fast-replies-export-decisions.ts",
    "check:evidence": "node tools/p16-evidence-selfcheck.mjs",
    "integration:smoke": "node tools/integration-v1-smoke.mjs",
    "sandbox:p16": "./tools/p16-sandbox-probe.sh",
    "sandbox:p20": "./tools/p20-brief-probe.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.146.0"
  }
}
