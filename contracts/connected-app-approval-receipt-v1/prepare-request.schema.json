{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trained-assist.invalid/connected-app-approval-receipt-v1/prepare-request.schema.json",
  "title": "Connected App approval prepare request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["appToken", "audience", "command", "sourceRevision", "operation"],
  "properties": {
    "appToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "audience": { "enum": ["crm-web", "recruiting-web"] },
    "command": { "enum": ["crm.deals.create", "recruiting.responses.message.send"] },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "audience": { "const": "crm-web" } }, "required": ["audience"] },
      "then": { "properties": { "command": { "const": "crm.deals.create" } } } },
    { "if": { "properties": { "audience": { "const": "recruiting-web" } }, "required": ["audience"] },
      "then": { "properties": { "command": { "const": "recruiting.responses.message.send" } } } }
  ]
}
