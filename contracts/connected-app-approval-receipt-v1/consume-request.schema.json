{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trained-assist.invalid/connected-app-approval-receipt-v1/consume-request.schema.json",
  "title": "Connected App approval consume request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["appToken", "audience", "command", "sourceRevision", "operation", "intentId", "consumerRequestId"],
  "properties": {
    "appToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "audience": { "enum": ["crm-web", "recruiting-web"] },
    "command": { "enum": ["crm.deals.create", "recruiting.assignment.material.send"] },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation": { "type": "object" },
    "intentId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "consumerRequestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
  },
  "allOf": [
    { "if": { "properties": { "audience": { "const": "crm-web" } }, "required": ["audience"] },
      "then": { "properties": { "command": { "const": "crm.deals.create" } } } },
    { "if": { "properties": { "audience": { "const": "recruiting-web" } }, "required": ["audience"] },
      "then": { "properties": { "command": { "const": "recruiting.assignment.material.send" },
        "operation": { "type": "object", "additionalProperties": false,
          "required": ["vacancyId", "negotiationId", "chatId", "sourceSha256", "savedPlanRevisionSha256", "materialSha256", "agreementMessageId", "message"],
          "properties": {
            "vacancyId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
            "negotiationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
            "chatId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
            "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "savedPlanRevisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "materialSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "agreementMessageId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
            "message": { "type": "string", "minLength": 1, "maxLength": 12000 }
          }
        }
      } } }
  ]
}
