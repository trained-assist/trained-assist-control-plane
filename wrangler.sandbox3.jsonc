{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trained-assist-cp-sandbox3",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ta-sandbox3-taskstore",
    "database_id": "1e1b8108-9186-43e2-8e50-436598233165",
    "migrations_dir": "migrations"
  }],
  "workflows": [{
    "name": "ta-cp-sandbox3-task-workflow",
    "binding": "TASK_WORKFLOW",
    "class_name": "TaskWorkflow"
  }],
  "vars": {
    "DEPLOYMENT_ENV": "sandbox3",
    "RUNNER_API_ENGINE_SELECTION": "agent_api",
    "RUNNER_API_URL": "https://169-58-15-230.sslip.io/runner-sandbox3",
    "SANDBOX_RUNNER_MOCK_PROBE_ENABLED": "true",
    "SANDBOX_RUNNER_MOCK_PROBE_PROFILE": "integration-sandbox3-v1",
    "RUNNER_PROFILE_DELEGATION_PRINCIPAL_ID": "sandbox3-agent-api-principal",
    "RUNNER_PROFILE_DELEGATION_TENANT_ID": "sandbox3-acceptance-a-20261008",
    "RUN_SPEC_ENV_ALLOWLIST": "LLM_LADDER_TOKEN",
    "RUN_SPEC_TIMEOUT_MS": "180000",
    "RUN_SPEC_STARTUP_TIMEOUT_MS": "600000",
    "RUN_SPEC_MAX_OUTPUT_BYTES": "1048576",
    "RUN_SPEC_MAX_LOG_BYTES": "1048576",
    "PREVIEW_ONLY": "true",
    "PILOT_ENABLED": "false",
    "ROUTER_AGENT_ALLOWED": "false"
  }
}
